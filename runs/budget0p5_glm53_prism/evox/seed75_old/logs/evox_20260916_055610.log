def compute_model_placement(gpu_num, models):
    """
    Iterated local search: multi-start greedy (deterministic orderings plus
    seeded randomized restarts), each refined by lexicographic best-improvement
    local search (moves + swaps + relocations). The best placement is then
    perturbed (random relocations) and re-optimized repeatedly within a time
    budget. Returns the placement with the lowest max KVPR.
    """
    import random
    import time

    TIME_BUDGET = 30.0
    start = time.time()

    def greedy(order):
        placement = {g: [] for g in range(gpu_num)}
        free_mem = [GPU_MEM_SIZE] * gpu_num
        pressure = [0.0] * gpu_num
        for model in order:
            best_idx, best_kvpr = None, float('inf')
            for g in range(gpu_num):
                rem = free_mem[g] - model.model_size
                if rem > 0:
                    kvpr = (pressure[g] + model.req_rate / model.slo) / rem
                    if kvpr < best_kvpr:
                        best_kvpr, best_idx = kvpr, g
            if best_idx is None:
                return None
            placement[best_idx].append(model)
            pressure[best_idx] += model.req_rate / model.slo
            free_mem[best_idx] -= model.model_size
        return placement, pressure, free_mem

