    """
    Multi-restart randomized greedy search.

    Repeatedly builds schedules by greedily appending the transaction
    (chosen from a random candidate sample) that yields the lowest actual
    makespan via workload.get_opt_seq_cost. Keeps the best schedule across
    all restarts within a time budget. Random candidate sampling provides
    exploration to escape greedy traps.
    """
    TIME_BUDGET = 100.0  # seconds per workload
    start_time = time.time()

    best_cost = float('inf')
    best_seq = None

    n = workload.num_txns

    def greedy_run(sample_rate, cand_samples):
        start_txn = random.randrange(n)
        txn_seq = [start_txn]
        remaining = [x for x in range(n) if x != start_txn]
        while remaining:
            # sample candidate set
            k = min(len(remaining), cand_samples)
            cands = random.sample(remaining, k) if k < len(remaining) else list(remaining)
            # 
