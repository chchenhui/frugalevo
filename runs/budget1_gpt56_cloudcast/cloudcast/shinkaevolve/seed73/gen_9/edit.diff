+class _MarginalBroadcastPlanner:
+    """Scalable fallback when exact exponential optimization is too large."""
+
+    def __init__(self, graph: nx.DiGraph, src, terminals: List):
+        self.graph = graph
+        self.src = src
+        self.terminals = terminals
+
+    def solve(self) -> nx.DiGraph:
+        tree = nx.DiGraph()
+        tree.add_node(self.src)
+        remaining = set(self.terminals)
+
+        while remaining:
+            def marginal_cost(u, v, data):
+                return 0.0 if tree.has_edge(u, v) else float(data["cost"])
+
+            best = None
+
+            for dst in remaining:
+                try:
+                    path = nx.dijkstra_path(
+                        self.graph,
+                        self.src,
+                        dst,
+                        weight=marginal_cost,
+                    )
+                except nx.NetworkXNoPath:
+                    continue
+
+                incremental = sum(
+                    0.0 if tree.has_edge(u, v) else float(self.graph[u][v]["cost"])
+                    for u, v in zip(path, path[1:])
+                )
+
+                candidate = (incremental, len(path), str(dst), dst, path)
+                if best is None or candidate < best:
+                    best = candidate
+
+            if best is None:
+                raise nx.NetworkXNoPath(
+                    f"No broadcast path exists from {self.src} to {sorted(remaining)}"
+                )
+
+            _, _, _, dst, path = best
+            for u, v in zip(path, path[1:]):
+                tree.add_edge(u, v, **dict(self.graph[u][v]))
+            remaining.remove(dst)
+
+        return tree
+
