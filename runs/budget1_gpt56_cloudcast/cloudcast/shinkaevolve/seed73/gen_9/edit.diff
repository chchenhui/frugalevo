+class _TopologyMaterializer:
+    """Converts a shared tree into the legacy BroadCastTopology representation."""
+
+    def __init__(
+        self,
+        topology: BroadCastTopology,
+        tree: nx.DiGraph,
+        source_graph: nx.DiGraph,
+        src,
+    ):
+        self.topology = topology
+        self.tree = tree
+        self.source_graph = source_graph
+        self.src = src
+
+    def populate(self, dsts: Iterable):
+        for dst in dsts:
+            if dst == self.src:
+                edge_path = []
+            else:
+                path = nx.dijkstra_path(self.tree, self.src, dst, weight="cost")
+                edge_path = [
+                    [u, v, self.source_graph[u][v]]
+                    for u, v in zip(path, path[1:])
+                ]
+
+            for partition in range(self.topology.num_partitions):
+                self.topology.set_dst_partition_paths(
+                    dst,
+                    partition,
+                    list(edge_path),
+                )
+
