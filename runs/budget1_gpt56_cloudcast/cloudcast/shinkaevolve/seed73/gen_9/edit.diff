+class _BroadcastGraph:
+    """Creates a validated, source-rooted graph used by optimization."""
+
+    def __init__(self, graph: nx.DiGraph, src):
+        self.original = graph
+        self.src = src
+        self.graph = self._sanitize(graph, src)
+
+    @staticmethod
+    def _valid_cost(value) -> bool:
+        return (
+            isinstance(value, (int, float))
+            and not isinstance(value, bool)
+            and math.isfinite(float(value))
+            and float(value) >= 0.0
+        )
+
+    def _sanitize(self, graph: nx.DiGraph, src) -> nx.DiGraph:
+        cleaned = nx.DiGraph()
+        cleaned.add_nodes_from(graph.nodes(data=True))
+
+        for u, v, data in graph.edges(data=True):
+            if u == v or v == src:
+                continue
+            cost = data.get("cost")
+            if not self._valid_cost(cost):
+                continue
+            cleaned.add_edge(u, v, **dict(data))
+            cleaned[u][v]["cost"] = float(cost)
+
+        return cleaned
+
