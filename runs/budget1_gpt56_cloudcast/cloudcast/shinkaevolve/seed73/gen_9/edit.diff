+def search_algorithm(src, dsts, G, num_partitions):
+    """
+    Build a minimum-cost shared broadcast topology.
+
+    For up to 15 unique remote destinations, this computes an exact directed
+    Steiner tree.  The tree pays for each selected network link once per data
+    partition and uses relay clouds to fan out data to multiple destinations.
+    """
+    topology = BroadCastTopology(src, dsts, num_partitions)
+
+    unique_dsts = list(dict.fromkeys(dsts))
+    terminals = [dst for dst in unique_dsts if dst != src]
+
+    if not terminals:
+        _TopologyMaterializer(topology, nx.DiGraph([(src, src)]), G, src).populate(dsts)
+        return topology
+
+    network = _BroadcastGraph(G, src)
+    graph = network.graph
+
+    missing = [dst for dst in terminals if dst not in graph]
+    if missing or src not in graph:
+        raise nx.NetworkXNoPath(f"No broadcast path exists to {missing}")
+
+    # Exact dynamic programming materially reduces redundant cloud egress for
+    # normal broadcast sizes.  The fallback prevents exponential blowups.
+    if len(terminals) <= 15:
+        tree = _ExactSteinerPlanner(graph, src, terminals).solve()
+    else:
+        tree = _MarginalBroadcastPlanner(graph, src, terminals).solve()
+
+    _TopologyMaterializer(topology, tree, G, src).populate(dsts)
+    return topology
+
