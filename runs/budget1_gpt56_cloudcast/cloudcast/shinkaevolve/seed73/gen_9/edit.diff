+class _ExactSteinerPlanner:
+    """Dreyfus-Wagner style directed Steiner tree solver."""
+
+    def __init__(self, graph: nx.DiGraph, src, terminals: List):
+        self.graph = graph
+        self.src = src
+        self.terminals = terminals
+        self.nodes = list(graph.nodes())
+        self.node_index = {node: index for index, node in enumerate(self.nodes)}
+        self.reverse = graph.reverse(copy=False)
+
+    def solve(self) -> nx.DiGraph:
+        terminal_count = len(self.terminals)
+        state_count = 1 << terminal_count
+        infinity = float("inf")
+
+        costs = [
+            {node: infinity for node in self.nodes}
+            for _ in range(state_count)
+        ]
+        decisions = [{} for _ in range(state_count)]
+
+        for mask in range(1, state_count):
+            state_costs = costs[mask]
+            state_choices = decisions[mask]
+
+            if mask & (mask - 1) == 0:
+                terminal = self.terminals[mask.bit_length() - 1]
+                state_costs[terminal] = 0.0
+                state_choices[terminal] = ("terminal",)
+
+            self._merge_subsets(mask, costs, state_costs, state_choices)
+            self._relax_reverse_edges(state_costs, state_choices)
+
+        full_mask = state_count - 1
+        if costs[full_mask][self.src] == infinity:
+            raise nx.NetworkXNoPath(
+                f"No broadcast path exists from {self.src} to {self.terminals}"
+            )
+
+        return self._reconstruct(full_mask, decisions)
+
+    def _merge_subsets(self, mask, all_costs, state_costs, state_choices):
+        subset = (mask - 1) & mask
+
+        while subset:
+            complement = mask ^ subset
+
+            # Evaluating each unordered split once avoids redundant work.
+            if complement and subset < complement:
+                left = all_costs[subset]
+                right = all_costs[complement]
+
+                for node in self.nodes:
+                    candidate = left[node] + right[node]
+                    if candidate < state_costs[node]:
+                        state_costs[node] = candidate
+                        state_choices[node] = ("split", subset, complement)
+
+            subset = (subset - 1) & mask
+
+    def _relax_reverse_edges(self, state_costs, state_choices):
+        """Propagate each solved sub-tree upstream with multi-source Dijkstra."""
+        sequence = itertools.count()
+        heap = [
+            (cost, next(sequence), node)
+            for node, cost in state_costs.items()
+            if cost < float("inf")
+        ]
+        heapq.heapify(heap)
+
+        while heap:
+            current_cost, _, node = heapq.heappop(heap)
+            if current_cost != state_costs[node]:
+                continue
+
+            for predecessor in self.reverse.neighbors(node):
+                edge_cost = float(self.graph[predecessor][node]["cost"])
+                candidate = current_cost + edge_cost
+
+                if candidate < state_costs[predecessor]:
+                    state_costs[predecessor] = candidate
+                    state_choices[predecessor] = ("edge", node)
+                    heapq.heappush(
+                        heap,
+                        (candidate, next(sequence), predecessor),
+                    )
+
+    def _reconstruct(self, full_mask, decisions) -> nx.DiGraph:
+        tree = nx.DiGraph()
+        tree.add_node(self.src)
+        expanded = set()
+
+        def expand(node, mask):
+            state = (node, mask)
+            if state in expanded:
+                return
+            expanded.add(state)
+
+            decision = decisions[mask].get(node)
+            if decision is None:
+                raise nx.NetworkXNoPath(
+                    "Unable to reconstruct exact broadcast topology"
+                )
+
+            kind = decision[0]
+
+            if kind == "terminal":
+                return
+
+            if kind == "split":
+                expand(node, decision[1])
+                expand(node, decision[2])
+                return
+
+            next_node = decision[1]
+            tree.add_edge(
+                node,
+                next_node,
+                **dict(self.graph[node][next_node]),
+            )
+            expand(next_node, mask)
+
+        expand(self.src, full_mask)
+        return tree
+
