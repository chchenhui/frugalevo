     if num_txns <= 7:
         import itertools
 
         best_cost = float("inf")
         best_schedule = None
         for sequence in itertools.permutations(range(num_txns)):
             cost = evaluate(sequence)
             if cost < best_cost:
                 best_cost = cost
                 best_schedule = list(sequence)
