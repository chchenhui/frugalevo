+    while pair_rounds < 3:
+        pair_rounds += 1
+        if num_txns <= 18:
+            source_positions = list(range(num_txns))
+        else:
+            source_positions = sorted(
+                set(
+                    int(round(index * (num_txns - 1) / 11.0))
+                    for index in range(12)
+                )
+            )
+
+        if num_txns <= 30:
+            destination_positions = None
+        else:
+            destination_positions = sorted(
+                set(
+                    int(round(index * (num_txns - 1) / 15.0))
+                    for index in range(16)
+                )
+            )
+
+        pair_best_cost = best_cost
+        pair_best_schedule = best_schedule
+
+        for first_offset, first_source in enumerate(source_positions):
