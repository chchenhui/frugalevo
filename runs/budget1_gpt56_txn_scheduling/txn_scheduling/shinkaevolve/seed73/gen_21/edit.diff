     def refine(order, current_cost):
         # Best-improving adjacent exchanges cheaply remove many ordering
         # inversions caused by greedy prefix decisions.
         for _ in range(min(8, num_txns)):
             move_cost = current_cost
             move_order = None
             for index in range(num_txns - 1):
                 candidate = order[:]
                 candidate[index], candidate[index + 1] = (
                     candidate[index + 1], candidate[index]
                 )
                 candidate_cost = schedule_cost(candidate)
                 if candidate_cost < move_cost:
                     move_cost, move_order = candidate_cost, candidate
             if move_order is None:
                 break
             order, current_cost = move_order, move_cost
 
         # Insertions can escape an adjacent-swap local minimum.  Exhaustively
         # test them for small workloads and use a bounded unbiased sample for
         # large ones to keep optimization time predictable.
         for _ in range(4):
             if num_txns <= 30:
                 moves = [
                     (source, destination)
                     for source in range(num_txns)
                     for destination in range(num_txns)
                     if source != destination
                 ]
             else:
                 moves = [
                     (random.randrange(num_txns), random.randrange(num_txns))
                     for _ in range(6 * num_txns)
                 ]
 
             move_cost = current_cost
             move_order = None
             for source, destination in moves:
                 if source == destination:
                     continue
                 candidate = order[:]
                 txn = candidate.pop(source)
                 candidate.insert(destination, txn)
                 candidate_cost = schedule_cost(candidate)
                 if candidate_cost < move_cost:
                     move_cost, move_order = candidate_cost, candidate
             if move_order is None:
                 break
             order, current_cost = move_order, move_cost
 
         # A beneficial ordering change is often a swap between transactions
         # separated by several unrelated transactions.  Neither an adjacent
         # exchange nor a single greedy prefix decision reliably discovers this
         # conflict-ordering correction.
         for _ in range(4):
             if num_txns <= 36:
                 moves = [
                     (left, right)
                     for left in range(num_txns - 1)
                     for right in range(left + 1, num_txns)
                 ]
             else:
                 moves = [
                     tuple(sorted(random.sample(range(num_txns), 2)))
                     for _ in range(8 * num_txns)
                 ]
 
             move_cost = current_cost
             move_order = None
             for left, right in moves:
                 candidate = order[:]
                 candidate[left], candidate[right] = candidate[right], candidate[left]
                 candidate_cost = schedule_cost(candidate)
                 if candidate_cost < move_cost:
                     move_cost, move_order = candidate_cost, candidate
             if move_order is None:
                 break
             order, current_cost = move_order, move_cost
 
         return current_cost, order
 
     best_cost, best_order = refine(best_order, best_cost)
 
     # Local insertion and exchange moves cannot improve schedules which need a
     # coordinated relocation of several conflicting transactions.  Destroy a
     # small neighborhood and repair it with exact-cost best-position
     # insertions, then run the existing VND again from every improvement.
     if num_txns >= 4:
         repair_attempts = min(10, max(3, num_seqs))
         max_removed = min(6, max(3, num_txns // 4))
 
         for attempt in range(repair_attempts):
             remove_count = random.randint(3, max_removed)
 
             # Alternating contiguous and dispersed destruction makes it
             # possible to repair both a bad conflict region and long-range
             # ordering interactions.
             if attempt % 2 == 0:
                 first = random.randrange(num_txns - remove_count + 1)
                 removed_positions = list(range(first, first + remove_count))
             else:
                 removed_positions = random.sample(range(num_txns), remove_count)
 
             removed_positions.sort()
             removed = [best_order[position] for position in removed_positions]
             partial = [
                 txn for position, txn in enumerate(best_order)
                 if position not in set(removed_positions)
             ]
             random.shuffle(removed)
 
             # Reinsert one transaction at a time at its simulator-optimal
             # position.  Partial schedules are supported by the same exact
             # evaluator used during greedy construction.
             for txn in removed:
                 insert_cost = None
                 insert_positions = []
                 for position in range(len(partial) + 1):
                     candidate = partial[:]
                     candidate.insert(position, txn)
                     candidate_cost = schedule_cost(candidate)
                     if insert_cost is None or candidate_cost < insert_cost:
                         insert_cost = candidate_cost
                         insert_positions = [position]
                     elif candidate_cost == insert_cost:
                         insert_positions.append(position)
                 partial.insert(random.choice(insert_positions), txn)
 
             repaired_cost = schedule_cost(partial)
             if repaired_cost < best_cost:
                 best_cost, best_order = refine(partial, repaired_cost)
 
     return best_cost, best_order
 
