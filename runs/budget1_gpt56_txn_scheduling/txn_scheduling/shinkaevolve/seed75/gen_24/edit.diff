 def get_best_schedule(workload, num_seqs):
     """
     Find a low-makespan transaction permutation.
 
     Construction uses a simulator-scored beam of partial orderings.  Refinement
     uses exact makespan evaluations for relocation, swap, reversal, and
     contiguous block-relocation neighborhoods.
     """
     n = workload.num_txns
     if n == 0:
         return 0, []
     if n == 1:
         return workload.get_opt_seq_cost([0]), [0]
 
     cost_cache = {}
 
     def sequence_cost(sequence):
         key = tuple(sequence)
         value = cost_cache.get(key)
         if value is None:
             value = workload.get_opt_seq_cost(sequence)
             cost_cache[key] = value
         return value
 
     # Exact enumeration is both more reliable and generally cheaper than
     # elaborate heuristic search on tiny instances.
     if n <= 8:
         best_cost = None
         best_schedule = None
 
         def visit(prefix, remaining):
             nonlocal best_cost, best_schedule
             if not remaining:
                 value = sequence_cost(prefix)
                 if best_cost is None or value < best_cost:
                     best_cost = value
                     best_schedule = prefix[:]
                 return
 
             # Randomizing equal branches avoids a fixed transaction-id bias.
             choices = list(remaining)
             random.shuffle(choices)
             for txn in choices:
                 prefix.append(txn)
                 remaining.remove(txn)
                 visit(prefix, remaining)
                 remaining.add(txn)
                 prefix.pop()
 
         visit([], set(range(n)))
         return best_cost, best_schedule
 
     def choose_beam_width():
         requested = max(1, num_seqs)
         if n <= 22:
             return min(30, max(14, requested * 3))
         if n <= 40:
             return min(20, max(10, requested * 2))
         return min(12, max(6, requested))
 
     def build_beam():
         """
         Preserve several promising partial schedules rather than committing to
         one greedy next transaction.  Each partial schedule is scored by the
         simulator, so selection reflects actual conflict delay.
         """
         width = choose_beam_width()
         beam = [(0, tuple())]
 
         for _depth in range(n):
             candidates = []
 
             for _, prefix in beam:
                 used = set(prefix)
                 remaining = [txn for txn in range(n) if txn not in used]
 
                 # Full expansion is useful on normal workloads.  On large
                 # inputs retain a broad, changing candidate sample per parent.
                 if n <= 45 or len(remaining) <= 22:
                     extensions = remaining
                 else:
                     count = min(len(remaining), 24)
                     extensions = random.sample(remaining, count)
                     if remaining[0] not in extensions:
                         extensions[0] = remaining[0]
 
                 random.shuffle(extensions)
                 for txn in extensions:
                     sequence = prefix + (txn,)
                     candidates.append((sequence_cost(sequence), sequence))
 
             # A prefix cannot normally be duplicated, but this keeps beam
             # bookkeeping correct when candidate generation changes.
             unique = {}
             for value, sequence in candidates:
                 old = unique.get(sequence)
                 if old is None or value < old:
                     unique[sequence] = value
 
             ranked = [(value, sequence) for sequence, value in unique.items()]
             random.shuffle(ranked)
             ranked.sort(key=lambda item: item[0])
 
             # Avoid filling the beam entirely with schedules which made the
             # same final choice at this depth.
             next_beam = []
             represented_last = set()
             for value, sequence in ranked:
                 if sequence[-1] not in represented_last:
                     next_beam.append((value, sequence))
                     represented_last.add(sequence[-1])
                     if len(next_beam) >= width:
                         break
 
             if len(next_beam) < width:
                 selected = {sequence for _, sequence in next_beam}
                 for value, sequence in ranked:
                     if sequence not in selected:
                         next_beam.append((value, sequence))
                         selected.add(sequence)
                         if len(next_beam) >= width:
                             break
 
             beam = next_beam
 
         return sorted(beam, key=lambda item: item[0])
 
     def relocated(sequence, source, destination):
         """Move sequence[source] to a position in the post-removal sequence."""
         candidate = sequence[:]
         txn = candidate.pop(source)
         candidate.insert(destination, txn)
         return candidate
 
     def block_relocated(sequence, start, length, destination):
         """
         Remove a contiguous block and insert it into the remaining sequence.
         destination is deliberately interpreted after removal, preventing
         off-by-one ambiguity and preserving a valid permutation.
         """
         block = sequence[start:start + length]
         rest = sequence[:start] + sequence[start + length:]
         return rest[:destination] + block + rest[destination:]
 
     def best_standard_neighbor(current, current_cost):
         """
         Return the best strict improvement from ordinary one-transaction
         neighborhoods.  All decisions use the simulator's exact cost.
         """
         best_cost = current_cost
         best_sequence = None
 
         if n <= 34:
             relocation_moves = (
                 (source, destination)
                 for source in range(n)
                 for destination in range(n)
                 if source != destination
             )
         else:
             relocation_moves = (
                 (random.randrange(n), random.randrange(n))
                 for _ in range(650)
             )
 
         for source, destination in relocation_moves:
             if source == destination:
                 continue
             candidate = relocated(current, source, destination)
             value = sequence_cost(candidate)
             if value < best_cost:
                 best_cost = value
                 best_sequence = candidate
 
         if n <= 34:
             swap_moves = (
                 (left, right)
                 for left in range(n - 1)
                 for right in range(left + 1, n)
             )
         else:
             swap_moves = (
                 tuple(sorted(random.sample(range(n), 2)))
                 for _ in range(420)
             )
 
         for left, right in swap_moves:
             candidate = current[:]
             candidate[left], candidate[right] = candidate[right], candidate[left]
             value = sequence_cost(candidate)
             if value < best_cost:
                 best_cost = value
                 best_sequence = candidate
 
         if n <= 30:
             reversal_moves = (
                 (left, right)
                 for left in range(n - 1)
                 for right in range(left + 2, min(n, left + 8))
             )
         else:
             reversal_moves = (
                 (random.randrange(n - 2), random.randrange(3, min(9, n)))
                 for _ in range(240)
             )
 
         for move in reversal_moves:
             if n <= 30:
                 left, right = move
             else:
                 left, length = move
                 right = min(n - 1, left + length)
 
             candidate = (
                 current[:left] +
                 list(reversed(current[left:right + 1])) +
                 current[right + 1:]
             )
             value = sequence_cost(candidate)
             if value < best_cost:
                 best_cost = value
                 best_sequence = candidate
 
         return best_cost, best_sequence
 
     def best_block_neighbor(current, current_cost):
         """
         Move coupled transactions together.  A pair of writers/readers often
         has no improving individual relocation, while moving the pair across a
         conflicting region removes several dependency delays at once.
         """
         best_cost = current_cost
         best_sequence = None
 
         lengths = [2]
         if n <= 22:
             lengths.append(3)
 
         for length in lengths:
             if length >= n:
                 continue
 
             if n <= 32:
                 moves = (
                     (start, destination)
                     for start in range(n - length + 1)
                     for destination in range(n - length + 1)
                     if destination != start
                 )
             else:
                 samples = 300 if length == 2 else 180
                 moves = (
                     (
                         random.randrange(n - length + 1),
                         random.randrange(n - length + 1)
                     )
                     for _ in range(samples)
                 )
 
             for start, destination in moves:
                 if destination == start:
                     continue
                 candidate = block_relocated(current, start, length, destination)
                 value = sequence_cost(candidate)
                 if value < best_cost:
                     best_cost = value
                     best_sequence = candidate
 
         return best_cost, best_sequence
 
     def descend(seed, seed_cost):
         """
         Variable-neighborhood descent.  Standard local moves are exhausted
         first; upon stagnation, larger block moves are examined.  If a block
         improves the schedule, ordinary moves are revisited from that new
         basin.
         """
         current = list(seed)
         current_cost = seed_cost
         max_passes = 10 if n <= 28 else 5
         tried_block_at_cost = False
 
         for _ in range(max_passes):
             value, candidate = best_standard_neighbor(current, current_cost)
             if candidate is not None:
                 current_cost, current = value, candidate
                 tried_block_at_cost = False
                 continue
 
             if not tried_block_at_cost:
                 tried_block_at_cost = True
                 value, candidate = best_block_neighbor(current, current_cost)
                 if candidate is not None:
                     current_cost, current = value, candidate
                     tried_block_at_cost = False
                     continue
 
             break
 
         return current_cost, current
 
