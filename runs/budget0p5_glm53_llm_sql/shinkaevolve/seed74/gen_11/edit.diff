+    def _score_serial(self, strs: List[str]) -> int:
+        """Ideal Trie reuse = sum of adjacent LCP over sorted strings."""
+        if len(strs) <= 1:
+            return 0
+        ss = sorted(strs)
+        total = 0
+        prev = ss[0]
+        for cur in ss[1:]:
+            total += self._lcp(prev, cur)
+            prev = cur
+        return total
