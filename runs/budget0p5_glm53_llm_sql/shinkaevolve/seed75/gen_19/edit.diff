+    @staticmethod
+    def _apply_group_constraints(order: List, groups: List[List]) -> List:
+        if not groups:
+            return list(order)
+        present = set(order)
+        group_of = {}
+        for g in groups:
+            for c in g:
+                group_of[c] = g
+        out, used = [], set()
+        for c in order:
+            if c in used:
+                continue
+            g = group_of.get(c)
+            if g is None:
+                out.append(c)
+                used.add(c)
+            else:
+                for gc in g:
+                    if gc in present and gc not in used:
+                        out.append(gc)
+                        used.add(gc)
+        for c in order:  # safety: never drop columns
+            if c not in used:
+                out.append(c)
+                used.add(c)
+        return out
