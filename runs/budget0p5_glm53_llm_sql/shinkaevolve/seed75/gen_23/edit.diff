+    def _lcp(a, b):
         n = min(len(a), len(b))
         if n == 0:
             return 0
         if a[:n] == b[:n]:
             return n
         lo, hi = 0, n - 1
         while lo < hi:
             mid = (lo + hi + 1) // 2
             if a[:mid] == b[:mid]:
                 lo = mid
             else:
                 hi = mid - 1
         return lo
 
