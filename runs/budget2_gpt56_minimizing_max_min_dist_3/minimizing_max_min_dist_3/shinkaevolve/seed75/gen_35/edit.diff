     ii, jj = np.triu_indices(n, 1)
 
     def normalize(x: np.ndarray) -> np.ndarray:
         x = np.asarray(x, dtype=float)
         x = x - x.mean(axis=0, keepdims=True)
         scale = np.sqrt(np.mean(np.sum(x * x, axis=1)))
         return x / max(scale, 1.0e-14)
 
