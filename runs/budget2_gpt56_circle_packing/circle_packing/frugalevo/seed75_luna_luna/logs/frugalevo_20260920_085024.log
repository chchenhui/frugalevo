```python
        # Replace the fixed-lattice first stage with three stripwise layouts.
        # Each layout receives alternating horizontal-strip center relaxation,
        # followed by a joint unequal-radius epigraph optimization.
        def stripwise_candidates():
            """Build three six-strip layouts and optimize centers then radii."""
            populations = (
                (4, 5, 4, 5, 4, 4),
                (5, 4, 4, 4, 4, 5),
                (4, 4, 5, 4, 5, 4),
            )
            candidates = []

            for variant, counts in enumerate(populations):
                points = []
                strip_indices = []
                offset = 0

