         seed_radii = feasible_rescale(seed_centers, seed_radii)
         z0 = np.r_[seed_centers.ravel(), seed_radii]
 
         def constraints(z):
             c = z[:2 * n].reshape(n, 2)
             r = z[2 * n:]
             delta = c[ii] - c[jj]
             sums = r[ii] + r[jj]
             walls = np.r_[
                 c[:, 0] - r, c[:, 1] - r,
                 1.0 - c[:, 0] - r, 1.0 - c[:, 1] - r,
             ]
             # Squared contacts are smooth and work particularly well at
             # near-tangent contacts.
             contacts = 12.0 * (
                 np.einsum("ij,ij->i", delta, delta) - sums * sums
             )
             return np.r_[r, walls, contacts]
 
         def jacobian(z):
             c = z[:2 * n].reshape(n, 2)
             r = z[2 * n:]
             jac = np.zeros((5 * n + npairs, 3 * n), dtype=float)
             disk = np.arange(n)
 
             # r >= 0
             jac[disk, 2 * n + disk] = 1.0
             off = n
 
             # Four walls.
             jac[off + disk, 2 * disk] = 1.0
             jac[off + disk, 2 * n + disk] = -1.0
             jac[off + n + disk, 2 * disk + 1] = 1.0
             jac[off + n + disk, 2 * n + disk] = -1.0
             jac[off + 2 * n + disk, 2 * disk] = -1.0
             jac[off + 2 * n + disk, 2 * n + disk] = -1.0
             jac[off + 3 * n + disk, 2 * disk + 1] = -1.0
             jac[off + 3 * n + disk, 2 * n + disk] = -1.0
 
