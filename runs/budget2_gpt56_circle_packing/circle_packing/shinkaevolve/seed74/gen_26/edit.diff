             fun=lambda z: -np.sum(z[2 * n:]),
             x0=z0,
             jac=lambda z: np.r_[np.zeros(2 * n), -np.ones(n)],
             method="SLSQP",
             bounds=[(0.0, 1.0)] * (2 * n) + [(0.0, 0.5)] * n,
             constraints={"type": "ineq", "fun": constraints, "jac": jacobian},
             options={"maxiter": maxiter, "ftol": 1e-12, "disp": False},
         )
