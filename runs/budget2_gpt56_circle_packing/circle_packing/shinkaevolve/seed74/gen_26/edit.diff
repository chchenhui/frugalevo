             d = c[ii] - c[jj]
             sums = r[ii] + r[jj]
             jac[row, 2 * ii] = 24.0 * d[:, 0]
             jac[row, 2 * ii + 1] = 24.0 * d[:, 1]
             jac[row, 2 * jj] = -24.0 * d[:, 0]
             jac[row, 2 * jj + 1] = -24.0 * d[:, 1]
             jac[row, 2 * n + ii] = -24.0 * sums
             jac[row, 2 * n + jj] = -24.0 * sums
             return jac
 
