     from scipy.optimize import minimize, linprog
 
     n = 26
     ii, jj = np.triu_indices(n, 1)
     npairs = len(ii)
 
     pair_matrix = np.zeros((npairs, n), dtype=float)
     pair_matrix[np.arange(npairs), ii] = 1.0
     pair_matrix[np.arange(npairs), jj] = 1.0
 
     def lp_radii(centers):
         """Exactly maximize sum of radii for fixed centers."""
         edge = np.minimum.reduce((
             centers[:, 0], centers[:, 1],
             1.0 - centers[:, 0], 1.0 - centers[:, 1],
         ))
         distances = np.linalg.norm(centers[ii] - centers[jj], axis=1)
         safety = 1.0 - 2.0e-10
         answer = linprog(
             c=-np.ones(n),
             A_ub=pair_matrix,
             b_ub=safety * distances,
             bounds=[(0.0, max(0.0, safety * v)) for v in edge],
             method="highs",
         )
         if answer.success:
             return answer.x
         return compute_max_radii(centers)
 
     def feasible_rescale(centers, radii):
         """Commonly contract radii so a proposed warm start is feasible."""
         edge = np.minimum.reduce((
             centers[:, 0], centers[:, 1],
             1.0 - centers[:, 0], 1.0 - centers[:, 1],
         ))
         distances = np.linalg.norm(centers[ii] - centers[jj], axis=1)
         denom = radii[ii] + radii[jj]
         scale = min(
             1.0,
             float(np.min(edge / np.maximum(radii, 1e-15))),
             float(np.min(distances / np.maximum(denom, 1e-15))),
         )
         return radii * max(0.0, min(1.0, scale * (1.0 - 2e-9)))
 
     def optimize(seed_centers, seed_radii, maxiter):
