 def _constraints(vector):
     """Vector of nonnegative containment and pairwise separation slacks."""
     centers = vector[: 2 * N_CIRCLES].reshape(N_CIRCLES, 2)
     radii = vector[2 * N_CIRCLES:]
 
     x = centers[:, 0]
     y = centers[:, 1]
 
     walls = np.concatenate((
         x - radii,
         y - radii,
         1.0 - x - radii,
         1.0 - y - radii,
     ))
 
     delta = centers[PAIR_I] - centers[PAIR_J]
     distance_squared = np.einsum("ij,ij->i", delta, delta)
     pair_slack = distance_squared - (radii[PAIR_I] + radii[PAIR_J]) ** 2
 
     return np.concatenate((walls, pair_slack))
 
 
 def _constraint_jacobian(vector):
     """Analytic Jacobian for the geometric constraints."""
     centers = vector[: 2 * N_CIRCLES].reshape(N_CIRCLES, 2)
     radii = vector[2 * N_CIRCLES:]
     variable_count = 3 * N_CIRCLES
     pair_count = len(PAIR_I)
 
     jacobian = np.zeros((4 * N_CIRCLES + pair_count, variable_count))
 
     ids = np.arange(N_CIRCLES)
     x_col = 2 * ids
     y_col = 2 * ids + 1
     r_col = 2 * N_CIRCLES + ids
 
     # x-r, y-r, 1-x-r, 1-y-r
     jacobian[ids, x_col] = 1.0
     jacobian[ids, r_col] = -1.0
 
     jacobian[N_CIRCLES + ids, y_col] = 1.0
     jacobian[N_CIRCLES + ids, r_col] = -1.0
 
     jacobian[2 * N_CIRCLES + ids, x_col] = -1.0
     jacobian[2 * N_CIRCLES + ids, r_col] = -1.0
 
     jacobian[3 * N_CIRCLES + ids, y_col] = -1.0
     jacobian[3 * N_CIRCLES + ids, r_col] = -1.0
 
     offset = 4 * N_CIRCLES
     delta = centers[PAIR_I] - centers[PAIR_J]
     summed_radius = radii[PAIR_I] + radii[PAIR_J]
     rows = offset + np.arange(pair_count)
 
     jacobian[rows, 2 * PAIR_I] = 2.0 * delta[:, 0]
     jacobian[rows, 2 * PAIR_I + 1] = 2.0 * delta[:, 1]
     jacobian[rows, 2 * PAIR_J] = -2.0 * delta[:, 0]
     jacobian[rows, 2 * PAIR_J + 1] = -2.0 * delta[:, 1]
     jacobian[rows, 2 * N_CIRCLES + PAIR_I] = -2.0 * summed_radius
     jacobian[rows, 2 * N_CIRCLES + PAIR_J] = -2.0 * summed_radius
 
     return jacobian
 
 
 def compute_max_radii(centers):
     """
     Maximize the sum of radii for fixed centers.
 
     This is a linear program: every radius is bounded by its nearest wall and
     each pair has the linear condition r_i + r_j <= distance(i, j).
     """
     centers = np.asarray(centers, dtype=float)
     n = len(centers)
 
     wall_bounds = np.minimum.reduce((
         centers[:, 0],
         centers[:, 1],
         1.0 - centers[:, 0],
         1.0 - centers[:, 1],
     ))
     wall_bounds = np.maximum(wall_bounds, 0.0)
 
     pi, pj = np.triu_indices(n, 1)
     distances = np.linalg.norm(centers[pi] - centers[pj], axis=1)
 
     try:
         from scipy.optimize import linprog
 
         matrix = np.zeros((len(pi), n), dtype=float)
         matrix[np.arange(len(pi)), pi] = 1.0
         matrix[np.arange(len(pi)), pj] = 1.0
 
         result = linprog(
             c=-np.ones(n),
             A_ub=matrix,
             b_ub=distances,
             bounds=[(0.0, float(bound)) for bound in wall_bounds],
             method="highs",
         )
         if result.success:
             return np.maximum(0.0, result.x * SAFETY)
     except Exception:
         pass
 
     # Dependency-free conservative fallback.
     radii = 0.45 * wall_bounds
     for _ in range(80):
         changed = False
         for i, j, d in zip(pi, pj, distances):
             total = radii[i] + radii[j]
             if total > d and total > 0.0:
                 factor = 0.999999 * d / total
                 radii[i] *= factor
                 radii[j] *= factor
                 changed = True
         if not changed:
             break
     return radii * SAFETY
 
 
 def _certify(centers):
     """Use the fixed-center LP followed by a numerical safety certification."""
     radii = compute_max_radii(centers)
     wall = np.minimum.reduce((
         centers[:, 0],
         centers[:, 1],
         1.0 - centers[:, 0],
         1.0 - centers[:, 1],
     ))
     radii = np.minimum(radii, np.maximum(0.0, wall) * SAFETY)
 
     for i, j in zip(PAIR_I, PAIR_J):
         distance = np.linalg.norm(centers[i] - centers[j])
         total = radii[i] + radii[j]
         if total > distance and total > 0.0:
             scale = (distance * SAFETY) / total
             radii[i] *= scale
             radii[j] *= scale
     return radii
 
 
 def _improve_seed(centers, radii):
     """Run a constrained continuous optimization from one feasible seed."""
     try:
         from scipy.optimize import minimize
     except Exception:
