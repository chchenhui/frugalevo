    n = 11
    tri_area = np.sqrt(3.0) / 4.0

    # Fixed candidate triple indices (165, 3)
    idx = np.array(list(combinations(range(n), 3)))
    i0, i1, i2 = idx[:, 0], idx[:, 1], idx[:, 2]

    V = np.array([[0.0, 0.0], [1.0, 0.0], [0.5, np.sqrt(3.0) / 2.0]])

    def bary_to_xy(B):
        return B @ V

    def all_areas(B):
        P = bary_to_xy(B)
        a = P[i0]; b = P[i1]; c = P[i2]
        return 0.5 * np.abs(
            (b[:, 0] - a[:, 0]) * (c[:, 1] - a[:, 1])
            - (b[:, 1] - a[:, 1]) * (c[:, 0] - a[:, 0])
        ) / tri_area

    def softmin_vals(vals, t):
        # log-sum-exp soft minimum (values are >= 0)
        m = np.min(vals)
        return m - np.log(np.sum(np.exp(-t * (vals - m)))) / t

    def make_obj(t):
        def obj(z):
            B = np.exp(z).reshape(n, 3)
 
