def heilbronn_triangle11() -> np.ndarray:
    """
    Maximize the minimum area over all C(11,3)=165 triangles inside the
    equilateral reference triangle (area sqrt(3)/4).

    Approach:
    - Each point parameterized in barycentric coordinates via softmax of two
      free variables (always strictly inside the simplex -> feasibility by
      construction).
    - Objective: negative log-sum-exp soft-min of the 165 normalized areas,
