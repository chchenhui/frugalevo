def _triple_indices():
    """All C(11,3)=165 triples and a mask of triples sharing an edge label."""
    from itertools import combinations
    idx = np.array(list(combinations(range(11), 3)), dtype=np.int64)
    # edge labels: 0..3 -> AB, 4..7 -> BC, 8..10 -> CA
