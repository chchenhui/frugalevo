 def _to_xy(b):
     """Barycentric (u toward B(1,0), v toward C(0.5,sqrt3/2)) -> xy."""
     return np.column_stack([b[:, 0] + 0.5 * b[:, 1], 0.5 * _SQRT3 * b[:, 1]])
 
 
 def _clamp_simplex(b):
     """Project rows of b onto simplex u>=0, v>=0, u+v<=1."""
     b = np.clip(b, 0.0, 1.0)
     s = b.sum(axis=1)
     over = s > 1.0
     if np.any(over):
         b[over] *= (1.0 / s[over])[:, None]
     return b
 
 
