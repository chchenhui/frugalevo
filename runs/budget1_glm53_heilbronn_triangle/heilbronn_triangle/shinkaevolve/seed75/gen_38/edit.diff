+def _softmin_val(pts, p=60.0):
+    ar = _areas(pts) / TRI_AREA
+    m = ar.min()
+    return -((np.log(np.sum(np.exp(-p * (ar - m)))) - p * m) / (-p))  # negative softmin (maximize)
