+def _all_triples(n):
+    idxs = []
+    for i in range(n):
+        for j in range(i + 1, n):
+            for k in range(j + 1, n):
+                idxs.append((i, j, k))
+    return np.array(idxs)
+
+
+TRIPLES = _all_triples(N)
+TI = TRIPLES[:, 0]
+TJ = TRIPLES[:, 1]
+TK = TRIPLES[:, 2]
+
+
+def _areas(pts):
+    a = pts[TI]
+    b = pts[TJ]
+    c = pts[TK]
+    cross = (b[:, 0] - a[:, 0]) * (c[:, 1] - a[:, 1]) - (b[:, 1] - a[:, 1]) * (c[:, 0] - a[:, 0])
+    return 0.5 * np.abs(cross)
+
+
+def _min_area(pts):
+    return _areas(pts).min() / TRI_AREA
+
