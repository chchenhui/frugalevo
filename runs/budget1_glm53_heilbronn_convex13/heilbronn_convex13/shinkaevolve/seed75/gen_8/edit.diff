+def _bottleneck_vertex(pts):
+    """Index of a vertex participating in the smallest triangle."""
+    p = pts[TRI_IDX]
+    a = p[:, 0]
+    v1 = p[:, 1] - a
+    v2 = p[:, 2] - a
+    cr = np.abs(v1[:, 0]*v2[:, 1] - v1[:, 1]*v2[:, 0])
+    k = int(np.argmin(cr))
+    return int(TRI_IDX[k][0])
