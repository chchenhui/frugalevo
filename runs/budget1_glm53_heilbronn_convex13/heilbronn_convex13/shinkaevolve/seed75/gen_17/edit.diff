+    m = np.zeros(15); v = np.zeros(15)
+    b1, b2, eps = 0.9, 0.999, 1e-8
+    lr = 0.02
+    p = 4.0
+    step = 0
+    best_pts, best_sc = None, -1e18
+    while time.time() < deadline:
+        step += 1
+        g = numeric_grad(theta, ab, p)
+        m = b1*m + (1-b1)*g
+        v = b2*v + (1-b2)*g*g
+        mh = m / (1 - b1**step)
+        vh = v / (1 - b2**step)
+        upd = lr * mh / (np.sqrt(vh) + eps)
+        theta += upd[:13]
+        ab = np.maximum(ab + upd[13:], 0.05)
+        # exact score tracking
