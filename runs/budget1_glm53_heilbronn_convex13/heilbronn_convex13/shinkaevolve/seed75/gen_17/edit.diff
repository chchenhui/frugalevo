+def numeric_grad(theta, ab, p, h=1e-5):
+    base, _, _ = smooth_objective(theta, ab, p)
+    g = np.zeros(15)
+    for i in range(13):
+        t2 = theta.copy(); t2[i] += h
+        g[i] = (smooth_objective(t2, ab, p)[0] - base) / h
+    for i in range(2):
+        a2 = ab.copy(); a2[i] += h
+        g[13+i] = (smooth_objective(theta, a2, p)[0] - base) / h
+    return g
+
