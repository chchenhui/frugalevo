+def _subgradient_step(pts, tri_idx):
+    """Gradient step increasing the area of the currently smallest triangle."""
+    p = pts[tri_idx]
+    a = p[:, 0]
+    v1 = p[:, 1] - a
+    v2 = p[:, 2] - a
+    cross_val = v1[:, 0]*v2[:, 1] - v1[:, 1]*v2[:, 0]
+    areas = np.abs(cross_val)
+    k = int(np.argmin(areas))
+    s = 1.0 if cross_val[k] > 0 else -1.0
+    i, j, l = tri_idx[k]
+    A, B, C = pts[i], pts[j], pts[l]
+    # area = 0.5 * s * ((B-A) x (C-A)); derivative wrt points:
+    u = C - A   # = v2
+    w = B - A   # = v1
+    # dB = 0.5*s*perp(u); dC = -0.5*s*perp(w); dA = -(dB+dC)
+    perp = lambda v: np.array([-v[1], v[0]])
+    gB = 0.5 * s * perp(u)
+    gC = -0.5 * s * perp(w)
+    gA = -(gB + gC)
+    return i, gA, j, gB, l, gC
