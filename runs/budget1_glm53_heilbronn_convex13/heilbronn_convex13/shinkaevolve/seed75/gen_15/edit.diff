+def _hillclimb(pts, rng, deadline, sigma0=0.12):
+    pts = pts.copy()
+    sc = _score(pts)
+    sigma = sigma0
+    while time.time() < deadline:
+        improved = False
+        pool = None
+        for _ in range(150):
+            cand = pts.copy()
+            if rng.random() < 0.6:
+                if pool is None:
+                    pool = _bottleneck_pool(pts, k=5)
+                i = int(rng.choice(pool))
+            else:
+                i = int(rng.integers(13))
+            cand[i] += rng.normal(0, sigma, 2)
+            csc = _score(cand)
+            if csc > sc + 1e-12:
+                pts, sc = cand, csc
+                pool = None  # recompute bottleneck pool
+                improved = True
+        if improved:
+            sigma = min(sigma * 1.3, 0.3)
+        else:
+            sigma *= 0.55
+        if sigma < 1e-5:
+            break
+    return pts, sc
 
 
