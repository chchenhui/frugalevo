+def _bottleneck_pool(pts, k=5):
+    """Vertices of the k smallest triangles -> candidate move set."""
+    cr = _cross_all(pts)
+    idx = np.argpartition(cr, min(k, len(cr)-1))[:k]
+    return np.unique(TRI_IDX[idx])
