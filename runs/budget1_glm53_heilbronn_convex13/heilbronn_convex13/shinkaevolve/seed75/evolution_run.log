│ model_name               │ z-ai/glm-5.3                                                                              │
│ temperature              │ 1.0                                                                                       │
│ max_output_tokens        │ 16384                                                                                     │
│ reasoning                │ {'effort': 'low'}                                                                         │
│ diff_summary             │ added: 67; deleted: 0; modified: 10;                                                      │
