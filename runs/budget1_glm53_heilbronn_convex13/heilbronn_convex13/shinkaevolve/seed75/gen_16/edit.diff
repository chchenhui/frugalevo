 import numpy as np
 import time
 from itertools import combinations
 
 
 def _convex_hull_area(pts):
     P = sorted(map(tuple, np.round(pts, 12)))
     P = list(dict.fromkeys(P))
     if len(P) < 3:
         return 0.0
     def cross(o, a, b):
         return (a[0]-o[0])*(b[1]-o[1]) - (a[1]-o[1])*(b[0]-o[0])
     lower = []
     for p in P:
         while len(lower) >= 2 and cross(lower[-2], lower[-1], p) <= 0:
             lower.pop()
         lower.append(p)
     upper = []
     for p in reversed(P):
         while len(upper) >= 2 and cross(upper[-2], upper[-1], p) <= 0:
             upper.pop()
         upper.append(p)
     hull = lower[:-1] + upper[:-1]
     if len(hull) < 3:
         return 0.0
     H = np.array(hull)
     x, y = H[:, 0], H[:, 1]
     return 0.5 * abs(np.dot(x, np.roll(y, -1)) - np.dot(y, np.roll(x, -1)))
 
 
 def _min_triangle_area(pts, tri_idx):
     p = pts[tri_idx]
     a = p[:, 0]
     v1 = p[:, 1] - a
     v2 = p[:, 2] - a
     cross = np.abs(v1[:, 0]*v2[:, 1] - v1[:, 1]*v2[:, 0])
     return cross.min() * 0.5
 
 
 def _score(pts, tri_idx):
     ha = _convex_hull_area(pts)
     if ha <= 1e-12:
         return 0.0
     return _min_triangle_area(pts, tri_idx) / ha
 
 
 def _rescale_unit_hull(pts):
     ha = _convex_hull_area(pts)
     if ha > 1e-12:
         pts = pts / np.sqrt(ha)
     return pts
 
 
 def _subgradient_step(pts, tri_idx):
     """Gradient step increasing the area of the currently smallest triangle."""
     p = pts[tri_idx]
     a = p[:, 0]
     v1 = p[:, 1] - a
     v2 = p[:, 2] - a
     cross_val = v1[:, 0]*v2[:, 1] - v1[:, 1]*v2[:, 0]
     areas = np.abs(cross_val)
     k = int(np.argmin(areas))
     s = 1.0 if cross_val[k] > 0 else -1.0
     i, j, l = tri_idx[k]
     A, B, C = pts[i], pts[j], pts[l]
     # area = 0.5 * s * ((B-A) x (C-A)); derivative wrt points:
     u = C - A   # = v2
     w = B - A   # = v1
     # dB = 0.5*s*perp(u); dC = -0.5*s*perp(w); dA = -(dB+dC)
     perp = lambda v: np.array([-v[1], v[0]])
     gB = 0.5 * s * perp(u)
     gC = -0.5 * s * perp(w)
     gA = -(gB + gC)
     return i, gA, j, gB, l, gC
 
 
