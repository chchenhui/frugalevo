 def _hull_area(P):
     # Monotone chain, numpy-friendly
     order = np.lexsort((P[:, 1], P[:, 0]))
     pts = P[order]
     def chain(pts):
         out = []
         for p in pts:
             while len(out) >= 2:
                 o, a = out[-2], out[-1]
                 if (a[0]-o[0])*(p[1]-o[1]) - (a[1]-o[1])*(p[0]-o[0]) <= 0:
                     out.pop()
                 else:
                     break
             out.append(p)
         return out
     lo = chain(pts)
     up = chain(pts[::-1])
     hull = np.array(lo[:-1] + up[:-1])
     m = len(hull)
     a = 0.0
     for i in range(m):
         x1, y1 = hull[i]
         x2, y2 = hull[(i + 1) % m]
         a += x1 * y2 - x2 * y1
     return abs(a) * 0.5
 
 
