 import numpy as np
 
 
+def _all_triangle_areas(points: np.ndarray) -> np.ndarray:
+    """Vectorized areas of all C(n,3) triangles."""
+    n = len(points)
+    i, j, k = np.triu_indices(n, 3 - 1)
+    # indices of all triples
+    tri = np.array(np.meshgrid(np.arange(n), np.arange(n), np.arange(n), indexing="ij"))
+    # simpler: precompute combos
+    from itertools import combinations
+    combos = np.array(list(combinations(range(n), 3)))
+    p0 = points[combos[:, 0]]
+    p1 = points[combos[:, 1]]
+    p2 = points[combos[:, 2]]
+    cross = (p1[:, 0] - p0[:, 0]) * (p2[:, 1] - p0[:, 1]) - (
+        p1[:, 1] - p0[:, 1]
+    ) * (p2[:, 0] - p0[:, 0])
+    return 0.5 * np.abs(cross), combos
+
+
+def _min_triangle(points: np.ndarray):
+    areas, combos = _all_triangle_areas(points)
+    idx = np.argmin(areas)
+    return areas[idx], combos[idx]
+
