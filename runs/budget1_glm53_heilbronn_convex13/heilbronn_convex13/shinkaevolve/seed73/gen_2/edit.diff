+            pts.append((xs[c] + 0.05 * r, 0.1 + 0.38 * r))
+    pts = np.array(pts[:n])
+    if len(pts) < n:
+        pts = np.vstack([pts, 0.5 + 0.1 * rng.standard_normal((n - len(pts), 2))])
+    pts = np.clip(pts, 0.02, 0.98)
+    cands.append(pts)
+    # 3-fold symmetric ring around center + center point
+    c = 0.5
+    ang = 2 * np.pi / 12
+    ring = np.array(
+        [[c + r * np.cos(i * ang), c + r * np.sin(i * ang)] for i in range(12)]
+    )
+    ring = np.clip(ring, 0.03, 0.97)
+    pts = np.vstack([ring, [[c, c]]])
+    cands.append(pts[:n])
