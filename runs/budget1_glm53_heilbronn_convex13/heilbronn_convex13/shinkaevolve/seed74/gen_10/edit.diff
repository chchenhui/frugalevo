+def _softmin_grad(pts, beta):
+    """Smooth min of all triangle areas + analytic gradient wrt points."""
+    n = len(pts)
+    idx = np.array([(i, j, k) for i in range(n) for j in range(i+1, n)
+                    for k in range(j+1, n)])
+    a = pts[idx[:, 0]]
+    b = pts[idx[:, 1]]
+    c = pts[idx[:, 2]]
+    # area*2 (cross product) signed; use abs handled by orientation-invariant form:
+    # cross = (b-a) x (c-a)
