+def _hull_area(pts):
+    p = pts[np.argsort(pts[:, 0] + pts[:, 1] * 0.001)]
+    # Andrew's monotone chain
+    def cross(o, a, b):
+        return (a[0]-o[0])*(b[1]-o[1]) - (a[1]-o[1])*(b[0]-o[0])
+    lower = []
+    for q in p:
+        while len(lower) >= 2 and cross(lower[-2], lower[-1], q) <= 0:
+            lower.pop()
+        lower.append(q)
+    upper = []
+    for q in reversed(p):
+        while len(upper) >= 2 and cross(upper[-2], upper[-1], q) <= 0:
+            upper.pop()
+        upper.append(q)
+    hull = lower[:-1] + upper[:-1]
+    if len(hull) < 3:
+        return 1.0, pts
+    h = np.array(hull)
+    A = 0.5 * abs(np.sum(h[:, 0]*np.roll(h[:, 1], -1) - np.roll(h[:, 0], -1)*h[:, 1]))
+    # convexity: only hull points matter; interior points stay inside automatically
+    return A, h
