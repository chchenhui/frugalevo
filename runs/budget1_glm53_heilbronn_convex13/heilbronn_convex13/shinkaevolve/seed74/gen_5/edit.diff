 import numpy as np
 
 
+def _tri_areas(pts):
+    # areas of all C(n,3) triangles, vectorized
+    n = len(pts)
+    i, j, k = np.triu_indices(n, 3)
+    a = pts[i]; b = pts[j]; c = pts[k]
+    return 0.5 * np.abs((b[0]-a[0])*(c[1]-a[1]) - (b[1]-a[1])*(c[0]-a[0])), (i, j, k)
+
+
+def _hull_area(pts):
+    # convex hull area via monotone chain
+    p = sorted(map(tuple, pts))
+    if len(p) < 3:
+        return 1e-9
+    def cross(o, a, b):
+        return (a[0]-o[0])*(b[1]-o[1]) - (a[1]-o[1])*(b[0]-o[0])
+    lower = []
+    for q in p:
+        while len(lower) >= 2 and cross(lower[-2], lower[-1], q) <= 0:
+            lower.pop()
+        lower.append(q)
+    upper = []
+    for q in reversed(p):
+        while len(upper) >= 2 and cross(upper[-2], upper[-1], q) <= 0:
+            upper.pop()
+        upper.append(q)
+    hull = lower[:-1] + upper[:-1]
+    if len(hull) < 3:
+        return 1e-9
+    A = 0.0
+    for i in range(1, len(hull)-1):
+        o = hull[0]; a = hull[i]; b = hull[i+1]
+        A += abs((a[0]-o[0])*(b[1]-o[1]) - (a[1]-o[1])*(b[0]-o[0]))
+    return 0.5 * A
+
+
+def _objective(pts):
+    hull = _hull_area(pts)
+    if hull < 1e-12:
+        return -1e9, np.inf
+    areas, _ = _tri_areas(pts)
+    return areas.min() / hull, areas.min()
+
