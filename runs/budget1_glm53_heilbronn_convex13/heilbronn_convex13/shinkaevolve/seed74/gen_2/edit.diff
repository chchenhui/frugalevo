+def _seed_candidates(rng):
+    """Library of deterministic structured + random starting configurations."""
+    seeds = []
+    angles12 = np.linspace(0, 2*np.pi, 12, endpoint=False)
+    # 12-gon + center
+    p = np.vstack([np.c_[np.cos(angles12), np.sin(angles12)],
+                   np.zeros((1, 2))])
+    seeds.append(p)
+    # regular 13-gon
+    a13 = np.linspace(0, 2*np.pi, 13, endpoint=False)
+    seeds.append(np.c_[np.cos(a13), np.sin(a13)])
+    # outer hexagon + rotated inner hexagon + center
+    a6 = np.linspace(0, 2*np.pi, 6, endpoint=False)
+    outer = np.c_[np.cos(a6), np.sin(a6)]
+    inner = 0.55 * np.c_[np.cos(a6 + np.pi/6), np.sin(a6 + np.pi/6)]
+    seeds.append(np.vstack([outer, inner, np.zeros((1, 2))]))
+    # two staggered rings (6 + 6) with different radii, plus center
+    inner2 = 0.72 * np.c_[np.cos(a6 + np.pi/12), np.sin(a6 + np.pi/12)]
+    seeds.append(np.vstack([outer, inner2, np.zeros((1, 2))])
+                 )
+    # a few seeded random configs
+    for _ in range(6):
+        r = np.sqrt(rng.random((13,)))
+        th = 2*np.pi*rng.random((13,))
+        seeds.append(np.c_[r*np.cos(th), r*np.sin(th)])
+    return seeds
+
+
+def _refine(P, ev, rng, rounds=120, cands_per_point=8):
+    """Coordinate-descent refinement: perturb one point at a time,
+    accept only improvements to the global minimum triangle area."""
+    P = P.copy()
+    best = ev.min_area(P)
+    n = len(P)
+    radius = 0.25
+    for _ in range(rounds):
+        improved = False
+        order = rng.permutation(n)
+        for i in order:
+            dirs = rng.normal(size=(cands_per_point, 2))
+            dirs /= np.linalg.norm(dirs, axis=1, keepdims=True)
+            scales = radius * np.linspace(0.25, 1.0, cands_per_point)
+            deltas = dirs * scales[:, None]
+            for d in deltas:
+                Q = P.copy()
+                Q[i] = P[i] + d
+                val = ev.min_area(Q)
+                if val > best + 1e-14:
+                    P = Q
+                    best = val
+                    improved = True
+        radius *= 0.85
+        if radius < 1e-4:
+            break
+    return P, best
 
 
