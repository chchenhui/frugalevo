+def _convex_hull(P):
+    """Monotone chain convex hull; returns indices of hull vertices CCW."""
+    pts = P[np.lexsort((P[:, 1], P[:, 0]))]
+    if len(pts) <= 2:
+        return np.arange(len(P))
+
+    def cross(o, a, b):
+        return (a[0]-o[0])*(b[1]-o[1]) - (a[1]-o[1])*(b[0]-o[0])
+
+    lower = []
+    for i, p in enumerate(pts):
+        while len(lower) >= 2 and cross(pts[lower[-2]], pts[lower[-1]], p) <= 0:
+            lower.pop()
+        lower.append(i)
+    upper = []
+    for i in range(len(pts)-1, -1, -1):
+        p = pts[i]
+        while len(upper) >= 2 and cross(pts[upper[-2]], pts[upper[-1]], p) <= 0:
+            upper.pop()
+        upper.append(i)
+    hull = lower[:-1] + upper[:-1]
+    return np.array(hull)
+
+
+def _hull_area(P):
+    H = P[_convex_hull(P)]
+    x, y = H[:, 0], H[:, 1]
+    return 0.5 * abs(np.dot(x, np.roll(y, -1)) - np.dot(y, np.roll(x, -1)))
+
+
+def _normalize_unit_hull(P):
+    """Scale about centroid so convex hull area == 1."""
+    area = _hull_area(P)
+    if area <= 0:
+        return P
+    c = P.mean(axis=0)
+    return (P - c) / np.sqrt(area) + c
+
+
+class MinTriangleEvaluator:
+    """Vectorized evaluation of the minimum area over all C(13,3) triples."""
+
+    def __init__(self, n=13):
+        self.tri = np.array(list(combinations(range(n), 3)), dtype=int)
+
+    def areas(self, P):
+        A = P[self.tri[:, 0]]
+        B = P[self.tri[:, 1]]
+        C = P[self.tri[:, 2]]
+        return 0.5 * np.abs(
+            (B[:, 0]-A[:, 0])*(C[:, 1]-A[:, 1]) -
+            (B[:, 1]-A[:, 1])*(C[:, 0]-A[:, 0])
+        )
+
+    def min_area(self, P):
+        return float(self.areas(P).min())
+
