def _unpack(params: np.ndarray, n: int) -> np.ndarray:
    """Map 2n parameters to n points in strictly convex position.

    First n params: softmax logits -> x-gaps (positive, sum to 1).
    Last n params: softplus -> convex (increasing-slope) y increments.
    Guarantees a non-degenerate convex polygon forming the hull.
    """
    xl = params[:n] - params[:n].max()
    ex = np.exp(xl)
    gaps = ex / ex.sum()
    x = np.concatenate([[0.0], np.cumsum(gaps[1:])])

    d = params[n:]
    inc = np.log1p(np.exp(-np.abs(d))) + np.maximum(d, 0.0)  # softplus
    y = np.concatenate([[0.0], np.cumsum(inc)])
    return np.stack([x, y], axis=1)


