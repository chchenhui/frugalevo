def _decode_lattice(x: np.ndarray) -> np.ndarray:
    """Decode 30 params to 13 points on an affinely perturbed triangular lattice.

    Params 0..3: axis scale sx, axis scale sy (both in [0.5, 2.0]), shear in
    [-1, 1], global rotation phase. The affine map A = R(theta) @ [[sx, sh],
    [0, sy]] is nonsingular by construction, so the decoded 13 points are
    always distinct, finite, and have a nondegenerate convex hull.
    Params 4..29: per-point displacements in the box [-0.25, 0.25]^2 (scaled
    from [0,1]), allowing local symmetry breaking of the lattice fragment.
    """
    x = np.asarray(x, dtype=np.float64)
    sx = 0.5 + 1.5 * x[0]
    sy = 0.5 + 1.5 * x[1]
    sh = 2.0 * x[2] - 1.0
    th = 2.0 * np.pi * x[3]
