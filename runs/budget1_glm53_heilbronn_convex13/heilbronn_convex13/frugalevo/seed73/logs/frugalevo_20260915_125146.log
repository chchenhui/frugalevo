import numpy as np
from scipy.optimize import minimize
from scipy.spatial import ConvexHull


def _build_points(params):
    """Center point at origin + 12-gon ring with Fourier radius profile.

    params = [phi, a1, b1, a2, b2, a3, b3]:
      r(theta) = 1 + sum_k (a_k cos(6 k theta) + b_k sin(6 k theta))
    Amplitudes clipped so every radius stays in [0.6, 1.4], keeping the ring
    star-shaped with distinct angles (no duplicates, non-degenerate hull).
    """
    phi = params[0]
    amps = np.clip(np.asarray(params[1:7], dtype=float), -0.18, 0.18)
    k = np.arange(1, 4, dtype=float)
    theta = 2.0 * np.pi * np.arange(1, 13) / 12.0 + phi
    r = 1.0
    for j in range(3):
        r = r + amps[2 * j] * np.cos(6.0 * (j + 1) * theta) \
              + amps[2 * j + 1] * np.sin(6.0 * (j + 1) * theta)
    r = np.clip(r, 0.6, 1.4)
    ring = np.stack([r * np.cos(theta), r * np.sin(theta)], axis=1)
    return np.vstack([np.zeros((1, 2), dtype=float), ring])


