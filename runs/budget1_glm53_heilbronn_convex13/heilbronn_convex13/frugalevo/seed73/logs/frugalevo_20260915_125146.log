    if hull_area <= 0 or not np.isfinite(hull_area):
        return -1.0
    for c in range(2, n):
        pa = points[a[: (c * (c - 1)) // 2]]
        pb = points[b[: (c * (c - 1)) // 2]]
        pc = points[c]
        area = 0.5 * np.abs(
            (pb[:, 0] - pa[:, 0]) * (pc[:, 1] - pa[:, 1])
            - (pb[:, 1] - pa[:, 1]) * (pc[:, 0] - pa[:, 0])
        )
        m = area.min()
        if m < best:
            best = m
    return best / hull_area


