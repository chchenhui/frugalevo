import numpy as np
from itertools import combinations
from scipy.optimize import minimize
from scipy.special import logsumexp
from scipy.spatial import ConvexHull


def _tri_areas(P):
    """Areas of all C(n,3) triangles, vectorized."""
    idx = np.array(list(combinations(range(len(P)), 3)))
    a = P[idx[:, 0]]
    b = P[idx[:, 1]]
    c = P[idx[:, 2]]
    return np.abs((b[:, 0] - a[:, 0]) * (c[:, 1] - a[:, 1])
                  - (c[:, 0] - a[:, 0]) * (b[:, 1] - a[:, 1])) * 0.5, idx


def _hull_area(P):
    """Convex hull area (falls back to shoelace of hull via scipy)."""
    try:
        return ConvexHull(P).volume
    except Exception:
        return 1e-12


def _smooth_obj(x, n, beta):
    """Negative smooth-min (log-sum-exp) of normalized triangle areas."""
    P = x.reshape(n, 2)
    areas, _ = _tri_areas(P)
    ha = _hull_area(P)
    if ha <= 1e-12:
        return 1e6
    norm = areas / ha
    return -logsumexp(beta * np.log(np.maximum(norm, 1e-300))) / beta


