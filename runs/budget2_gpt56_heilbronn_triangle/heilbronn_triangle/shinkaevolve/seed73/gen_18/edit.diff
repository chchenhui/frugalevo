     def project(uv: np.ndarray) -> np.ndarray:
         """Map arbitrary pairs into the closed barycentric simplex."""
         w0 = 1.0 - uv[..., 0] - uv[..., 1]
         weights = np.stack((w0, uv[..., 0], uv[..., 1]), axis=-1)
         np.maximum(weights, 1.0e-9, out=weights)
         weights /= weights.sum(axis=-1, keepdims=True)
         return weights[..., 1:]
 
     def normalized_areas(configs: np.ndarray) -> np.ndarray:
         chosen = configs[:, triples]
         a = chosen[:, :, 1] - chosen[:, :, 0]
         b = chosen[:, :, 2] - chosen[:, :, 0]
         return np.abs(a[..., 0] * b[..., 1] - a[..., 1] * b[..., 0])
 
