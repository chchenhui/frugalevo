 def _slsqp_polish(layout: np.ndarray) -> np.ndarray:
     """
     Optionally polish a fixed orientation chamber with an epigraph maximin NLP.
     """
     try:
         from scipy.optimize import minimize
 
         reference_signed = _signed_areas(layout[None, :, :])[0]
         orientation = np.sign(reference_signed)
         orientation[orientation == 0.0] = 1.0
         initial_area = float(np.min(np.abs(reference_signed)))
 
         def constraints(vector: np.ndarray) -> np.ndarray:
             tail = vector[:-1].reshape(_FREE, 2)
             level = vector[-1]
             signed = _signed_areas(tail[None, :, :])[0]
             return np.concatenate(
                 (
                     orientation * signed - level,
                     1.0 - np.sum(tail, axis=1),
                 )
             )
 
         result = minimize(
             fun=lambda vector: -vector[-1],
             x0=np.r_[layout.ravel(), initial_area],
             method="SLSQP",
             bounds=[(0.0, 1.0)] * (2 * _FREE) + [(0.0, 1.0)],
             constraints={"type": "ineq", "fun": constraints},
             options={"maxiter": 900, "ftol": 1.0e-12, "disp": False},
         )
 
         if result.success and np.all(np.isfinite(result.x)):
             candidate = _project_simplex(result.x[:-1].reshape(_FREE, 2))
             if _minimum_area(candidate) > _minimum_area(layout) + 1.0e-12:
                 return candidate
     except Exception:
         pass
 
     return layout
 
 
