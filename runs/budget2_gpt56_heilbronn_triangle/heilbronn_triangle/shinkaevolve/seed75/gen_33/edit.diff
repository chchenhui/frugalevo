 def _construct_layout() -> np.ndarray:
     """Build, validate, and convert the best deterministic search result."""
     try:
         rng = np.random.default_rng(11031987)
         best = None
         best_value = -np.inf
 
         for island in range(6):
             candidate = _active_island_search(rng, _initial_layout(rng, island))
             value = _minimum_area(candidate)
 
             if value > best_value:
                 best = candidate
                 best_value = value
 
         if best is None or not np.all(np.isfinite(best)):
             return _fallback()
 
         best = _slsqp_polish(best)
         affine = np.vstack((_CORNERS_UV, best))
         result = _affine_to_cartesian(affine)
 
         if result.shape != (11, 2) or not np.all(np.isfinite(result)):
             return _fallback()
 
         return result
     except Exception:
         return _fallback()
 
 
