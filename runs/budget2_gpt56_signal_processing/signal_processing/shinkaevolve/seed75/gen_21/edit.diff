         )
         process_covariance = acceleration_var * np.array(
             [[0.25, 0.5], [0.5, 1.0]],
             dtype=float,
         )
         predicted_covariance += process_covariance
 
         innovation_variance = predicted_covariance[0, 0] + measurement_var
         gain = predicted_covariance[:, 0] / innovation_variance
         state = predicted_state + gain * bounded_innovation
         # Joseph-form covariance correction is more numerically stable than the
         # subtractive form when adaptive variances and gains change over time.
         # With H = [1, 0], (I - K H) has the compact form below.
         correction_matrix = np.array(
             [[1.0 - gain[0], 0.0], [-gain[1], 1.0]],
             dtype=float,
         )
         covariance = (
             correction_matrix @ predicted_covariance @ correction_matrix.T
             + measurement_var * np.outer(gain, gain)
         )
         covariance = 0.5 * (covariance + covariance.T)
         covariance[0, 0] = max(covariance[0, 0], 1e-12)
         covariance[1, 1] = max(covariance[1, 1], 1e-12)
 
         # Robust residual adaptation follows changing noise levels without letting
         # a single transition make the filter permanently sluggish.
         residual_var = min(
             bounded_innovation * bounded_innovation,
             9.0 * measurement_var,
         )
         measurement_var = max(0.97 * measurement_var + 0.03 * residual_var, 1e-12)
         # Apply a causal Schmitt-trigger style reversal gate to the reported
         # trajectory.  Kalman innovations close to a turning point are often
         # dominated by measurement noise; accepting every sign change creates
         # many false reversals even when level error remains low.
         candidate_level = state[0]
         if index >= 2:
             previous_level = filtered[index - 1]
             previous_step = previous_level - filtered[index - 2]
             candidate_step = candidate_level - previous_level
             reversal_margin = (
                 0.18 * np.sqrt(measurement_var)
                 + 0.25 * abs(previous_step)
             )
 
             if (
                 previous_step * candidate_step < 0.0
                 and abs(candidate_step) < reversal_margin
