 import numpy as np
+from scipy.optimize import minimize
+
+
+def _score(points):
+    d = np.linalg.norm(points[:, None, :] - points[None, :, :], axis=-1)
+    iu = np.triu_indices(len(points), 1)
+    dm = d[iu].min()
+    dx = d[iu].max()
+    return dm / dx
+
+
+def _repulsion_init(rng, n=14, iters=800):
+    # random points on unit sphere, spread by inverse-distance repulsion
+    pts = rng.randn(n, 3)
+    pts /= np.linalg.norm(pts, axis=1, keepdims=True)
+    for it in range(iters):
+        step = 0.02 * (0.99 ** it)
+        diff = pts[:, None, :] - pts[None, :, :]
+        dist = np.linalg.norm(diff, axis=-1) + 1e-9
+        np.fill_diagonal(dist, np.inf)
+        force = (diff / dist[:, :, None] ** 3).sum(axis=1)
+        pts += step * force
+        pts /= np.linalg.norm(pts, axis=1, keepdims=True)
+    return pts
+
+
+def _smooth_objective(flat, n=14, t=0.05):
+    pts = flat.reshape(n, 3)
+    d = np.linalg.norm(pts[:, None, :] - pts[None, :, :], axis=-1)
+    iu = np.triu_indices(n, 1)
+    dv = d[iu]
+    # soft min and max (log-sum-exp)
+    a = dv / t
+    soft_min = t * (-a.max() + np.log(np.exp(-a + a.max()).sum()))
+    b = dv / t
+    soft_max = t * (b.max() + np.log(np.exp(b - b.max()).sum()))
+    return -soft_min / soft_max
 
 
