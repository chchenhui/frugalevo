+def _anneal(P, iters=900, T0=0.35, T1=0.02, lr=0.05):
+    rng = np.random.default_rng(0)
+    P = P.copy()
+    # normalize scale
+    P = (P - P.mean(axis=0)) / (np.max(np.linalg.norm(P - P.mean(axis=0), axis=1)) + 1e-12)
+    m = np.zeros_like(P)
+    v = np.zeros_like(P)
+    b1, b2, eps = 0.9, 0.999, 1e-8
+    best_P = P.copy()
+    best_r = _exact_ratio(P)
+    for it in range(iters):
+        T = T0 * (T1 / T0) ** (it / max(iters - 1, 1))
+        f, g = _grad_f(P, T)
+        g = _gauge_fix(P, g)
+        # Adam update (ascent)
+        t = it + 1
+        m = b1 * m + (1 - b1) * g
+        v = b2 * v + (1 - b2) * g * g
+        mh = m / (1 - b1 ** t)
+        vh = v / (1 - b2 ** t)
+        step = lr * mh / (np.sqrt(vh) + eps)
+        P = P + step
+        # renormalize scale to keep problem well-conditioned
+        c = P.mean(axis=0)
+        P = P - c
+        mx = np.max(np.linalg.norm(P, axis=1))
+        if mx > 0:
+            P = P / mx
+        r = _exact_ratio(P)
+        if r > best_r:
+            best_r = r
+            best_P = P.copy()
+    return best_P, best_r
