+    for t in range(iters):
+        frac = t / max(1, iters - 1)
+        beta = beta0 * (beta1 / beta0) ** frac
+        diff = P[:, None, :] - P[None, :, :]
+        D = np.sqrt(np.sum(diff * diff, axis=-1) + 1e-18)
+        iu = np.triu_indices(n, 1)
