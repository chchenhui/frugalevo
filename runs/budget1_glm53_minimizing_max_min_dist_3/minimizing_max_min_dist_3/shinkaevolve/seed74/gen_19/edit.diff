+def _fit_sphere(X):
+    """Center and scale so max pairwise distance = 1."""
+    P = X - X.mean(axis=0)
+    D = np.linalg.norm(P[:, None] - P[None, :], axis=-1)
+    mx = D.max()
+    if mx > 0:
+        P = P / mx
+    return P
