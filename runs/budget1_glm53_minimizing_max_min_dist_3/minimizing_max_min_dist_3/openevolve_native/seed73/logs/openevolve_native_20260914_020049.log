        iu = np.triu_indices(n, 1)
        dm = D[iu].min()
        dx = D[iu].max()
        return dm / max(dx, 1e-12)

    def obj(x):
        p = x.reshape(n, d)
        D = np.linalg.norm(p[:, None, :] - p[None, :, :], axis=-1)
        iu = np.triu_indices(n, 1)
        dvec = D[iu]
        dm = dvec.min()
        dx = dvec.max()
        return -dm / max(dx, 1e-12)

