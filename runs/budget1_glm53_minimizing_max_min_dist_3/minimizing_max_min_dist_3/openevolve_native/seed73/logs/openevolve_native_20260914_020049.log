            res = minimize(obj, x0, method="SLSQP",
                           options={"maxiter": 300, "ftol": 1e-12})
            cand = res.x if ratio(res.x) > ratio(x0) else x0
        except Exception:
            cand = x0
        r = ratio(cand)
        if r > best_r:
            best_r, best_x = r, cand

