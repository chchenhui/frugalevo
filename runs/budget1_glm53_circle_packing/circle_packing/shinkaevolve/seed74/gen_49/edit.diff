+def _obj_grad(x, n, lam):
+    """Objective -sum(r) + lam*penalty; returns (val, grad) w.r.t. x.
+
+    Layout: x[0:2n] = centers (x0..x_{n-1}, y0..y_{n-1}); x[2n:3n] = radii.
+    Penalty uses squared hinge on overlaps and wall violations.
+    """
+    cx = x[0:n]
+    cy = x[n:2 * n]
+    r = x[2 * n:3 * n]
+    val = -float(np.sum(r))
+
+    g = np.zeros(3 * n)
+    g[2 * n:3 * n] = -1.0
+
+    dx = cx[:, None] - cx[None, :]
+    dy = cy[:, None] - cy[None, :]
+    d2 = dx * dx + dy * dy
+    np.fill_diagonal(d2, np.inf)
+    d = np.sqrt(d2)
+    ov = r[:, None] + r[None, :] - d
+    act = ov > 0
+    np.fill_diagonal(act, False)
+    if act.any():
+        pen = float(np.sum(ov[act] ** 2))
+        val += lam * pen
+        dovd = ov[act]
+        # d ov / d r_i
+        np.add.at(g[2 * n:3 * n], np.where(act)[0], dovd)
+        np.add.at(g[2 * n:3 * n], np.where(act)[1], dovd)
+        # d ov / d d = -1, d d / d centers
+        ii, jj = np.where(act)
+        w = 2.0 * ov[ii, jj] * (-1.0)
+        d_act = d[ii, jj]
+        safe = np.maximum(d_act, 1e-12)
