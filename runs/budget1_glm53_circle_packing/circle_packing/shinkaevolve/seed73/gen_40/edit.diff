     n = 26
     sqrt3 = np.sqrt(3.0)
     # Uniform lattice radius constraints for reference layouts
     r0 = min(1.0 / 10.0, 1.0 / (2.0 + 5.0 * sqrt3))
 
     # Multiple candidate row-count layouts (hexagonal-style rows)
     count_sets = [[5, 4, 5, 4, 5, 3], [5, 4, 5, 4, 4, 4],
                   [4, 5, 4, 5, 4, 4], [3, 5, 4, 5, 4, 5],
                   [5, 5, 4, 5, 4, 3], [4, 4, 5, 4, 5, 4]]
     stretch_factors = [1.0, 1.03, 1.06]
 
     seeds = []
