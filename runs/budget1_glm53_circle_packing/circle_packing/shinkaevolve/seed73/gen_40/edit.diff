+
+    def cons_j(z):
+        c, r = unpack(z)
+        dx = c[ii, 0] - c[jj, 0]
+        dy = c[ii, 1] - c[jj, 1]
+        d = np.sqrt(dx * dx + dy * dy) + 1e-12
+        m = len(ii)
+        J = np.zeros((m + 4 * n, z.size))
+        for k in range(m):
+            i, j = ii[k], jj[k]
+            J[k, 2 * i] = dx[k] / d[k]
+            J[k, 2 * i + 1] = dy[k] / d[k]
+            J[k, 2 * j] = -dx[k] / d[k]
+            J[k, 2 * j + 1] = -dy[k] / d[k]
