+    dyi = centers[ii, 1] - centers[jj, 1]
+
+    def unpack(z):
+        c = z[:2 * n].reshape(n, 2)
+        r = z[2 * n:]
+        return c, r
+
+    def obj(z):
+        return -np.sum(z[2 * n:])
+
+    def obj_grad(z):
+        g = np.zeros_like(z)
+        g[2 * n:] = -1.0
+        return g
+
+    def cons_f(z):
+        c, r = unpack(z)
+        dx = c[ii, 0] - c[jj, 0]
+        dy = c[ii, 1] - c[jj, 1]
+        d = np.sqrt(dx * dx + dy * dy)
