+def _init_hex(s):
+    """Hexagonal lattice layout: 6 staggered rows with counts 4,5,4,5,4,4."""
+    n = 26
+    centers = np.zeros((n, 2))
+    sqrt3_2 = np.sqrt(3.0) / 2.0
+    h = sqrt3_2 * s
